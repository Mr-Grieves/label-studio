# Secrets
.env

# Label Studio's own runtime data (db, uploaded media)
/data/

# Your source images -- large binaries, don't belong in git either
/images/

# ML backend runtime data
backends/*/data/

# Model weights (large binaries -- fetched separately, see README)
backends/medsam/checkpoints/*.pth

# OS cruft
.DS_Store

# Python
__pycache__/
*.pyc

# Staged-for-manual-deletion files (old venv, stale Label Studio data/) --
# see README.md "./data/ was reset"
/_to_delete/
